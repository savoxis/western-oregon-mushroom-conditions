# Generated by the nightly build on the server (never commit)
site/data/*
!site/data/c/
site/data/c/*
!site/data/c/habitat.json
!site/data/c/reality.json
!site/data/c/sensors.json

# Runtime state, caches and databases
/cache/
/data/
*.sqlite
*.sqlite-*
*.log
__pycache__/
*.pyc
*.bak*
*.tmp

# Secrets and host-specific config: these live only on the servers
*.env
.env*
gemini.json
build.json

# Analysis scratch outputs (large or re-creatable)
analysis/*.json
analysis/*.csv
